{
  "manifest_version": 2,
  "name": "startpage",
  "short_name": "startpage",
  "version": "1.12.0.1",
  "description": "Overrides the browsers newtab page with a custom startpage.",
  "author": "etacarinaea",

  "browser_specific_settings": {
    "gecko": {
      "id": "startpage@b100w11",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },

  "icons": {
    "48": "img/icon48.png",
    "96": "img/icon96.png",
    "128": "img/icon128.png",
    "192": "img/icon192.png"
  },

  "chrome_url_overrides": {
    "newtab": "index.html"
  },

  "background": {
    "scripts": [
      "js/update.js",
      "js/update-config.js"
    ]
  },

  "permissions": [
    "storage"
  ]
}
